# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase (for image uploads)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Crypto payments (Plisio)

# Plisio
PLISIO_API_KEY=your_api_key
# Optional: comma-separated list of allowed currencies/coins (Plisio "psyscid" codes)
PLISIO_ALLOWED_PSYS=
# Optional: required by Plisio API even when using fiat amounts. Default: BTC
PLISIO_DEFAULT_CURRENCY=BTC
# Optional invoice expiry minutes
PLISIO_EXPIRE_MIN=

# Hot Recharge API (Airtime)
HOT_ACCESS_CODE=your_access_code
HOT_PASSWORD=your_password
HOT_BASE_URL=https://ssl.hot.co.zw

# EcoCash Instant Payments API V3
# Test/preprod base URL from EcoCash spec. Replace with production URL when EcoCash activates live access.
ECOCASH_BASE_URL=https://payonline.ecocash.co.zw/ecocashGateway-preprod
ECOCASH_CHARGE_PATH=/payment/v1/transactions/amount
ECOCASH_STATUS_PATH_TEMPLATE=/payment/v1/{endUserId}/transactions/amount/{clientCorrelator}
# Optional: force the {endUserId} used for status lookups. If unset, the app tries merchant code first, then customer MSISDN.
ECOCASH_STATUS_END_USER_ID=
ECOCASH_AUTH_USERNAME=ecocash
ECOCASH_AUTH_PASSWORD=mobiquity
ECOCASH_MERCHANT_CODE=your_merchant_code
ECOCASH_MERCHANT_PIN=your_merchant_pin
ECOCASH_MERCHANT_NUMBER=your_merchant_number
ECOCASH_NOTIFY_URL=https://your-domain.com/api/ecocash/callback
ECOCASH_TERMINAL_ID=WEB
ECOCASH_LOCATION=Online
ECOCASH_SUPER_MERCHANT_NAME=Shoppy
ECOCASH_MERCHANT_NAME=Shoppy
ECOCASH_COUNTRY_CODE=ZW
ECOCASH_ON_BEHALF_OF=Shoppy

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# NextAuth
NEXTAUTH_SECRET=generate-a-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# Admin (for initial seed)
ADMIN_EMAIL=admin@shoppy.co.zw
ADMIN_PASSWORD=changeme123

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
